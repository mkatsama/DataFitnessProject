    <worksheet name='Sheet 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Recovery Score Average</run>
            <run fontcolor='#ffffff' fontname='Benton Sans Book' fontsize='14'>R</run>
            <run fontcolor='#ffffff' fontname='Benton Sans Book' fontsize='10'>ecovery Trend: 7-Day Average</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='10'>Green ≥ 67 · Yellow 34–66 · Red ≤ 33 | Jan–Sep 2026</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='exercises+ (fitness_data)' name='federated.0hpekg91c024ad1ccbvpn1flcucs' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Zone top ' datatype='real' name='[Parameter 0328254898896898]' param-domain-type='any' role='measure' type='quantitative' value='100.'>
              <calculation class='tableau' formula='100.' />
            </column>
            <column caption='Green Threshold' datatype='real' name='[Parameter 0328254899253251]' param-domain-type='any' role='measure' type='quantitative' value='67.'>
              <calculation class='tableau' formula='67.' />
            </column>
            <column caption='Yellow Threshold' datatype='real' name='[Parameter 0328254899585028]' param-domain-type='any' role='measure' type='quantitative' value='33.'>
              <calculation class='tableau' formula='33.' />
            </column>
            <column caption='Zone Bottom' datatype='real' name='[Parameter 0328254900068357]' param-domain-type='any' role='measure' type='quantitative' value='1.0'>
