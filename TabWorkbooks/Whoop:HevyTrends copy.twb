    <worksheet name='Sheet 4'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='14'>Daily Strain (Previous day) vs Recovery Score </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='exercises+ (fitness_data)' name='federated.0hpekg91c024ad1ccbvpn1flcucs' />
