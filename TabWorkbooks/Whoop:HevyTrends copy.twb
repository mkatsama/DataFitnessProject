    <worksheet name='Sheet 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='10'>Training Muscle Group Split</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#4b7095' fontsize='8'>Upper</run>
            <run bold='true' fontcolor='#ffffff' fontsize='8'> - </run>
            <run bold='true' fontcolor='#7fa9cb' fontsize='8'>Lower</run>
            <run bold='true' fontcolor='#ffffff' fontsize='8'> -</run>
            <run bold='true' fontsize='8'>Æ </run>
            <run bold='true' fontcolor='#cbecf4' fontsize='8'>Core/Cardio</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='exercises+ (fitness_data)' name='federated.0hpekg91c024ad1ccbvpn1flcucs' />
          </datasources>
          <datasource-dependencies datasource='federated.0hpekg91c024ad1ccbvpn1flcucs'>
            <column caption='Volume' datatype='real' name='[Calculation_0328254913155082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[weight_kg] * [reps]' />
            </column>
            <column datatype='string' name='[Primary Muscle Group (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[primary_muscle_group]' new-bin='true'>
                <bin default-name='false' value='&quot;Core/Cardio&quot;'>
                  <value>&quot;abdominals&quot;</value>
                  <value>&quot;cardio&quot;</value>
                  <value>&quot;full_body&quot;</value>
                  <value>&quot;other&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Lower Body&quot;'>
                  <value>&quot;abductors&quot;</value>
                  <value>&quot;adductors&quot;</value>
                  <value>&quot;calves&quot;</value>
                  <value>&quot;glutes&quot;</value>
                  <value>&quot;hamstrings&quot;</value>
                  <value>&quot;quadriceps&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Upper Body&quot;'>
                  <value>&quot;biceps&quot;</value>
                  <value>&quot;chest&quot;</value>
                  <value>&quot;forearms&quot;</value>
                  <value>&quot;lats&quot;</value>
                  <value>&quot;lower_back&quot;</value>
                  <value>&quot;neck&quot;</value>
                  <value>&quot;shoulders&quot;</value>
                  <value>&quot;traps&quot;</value>
                  <value>&quot;triceps&quot;</value>
                  <value>&quot;upper_back&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Primary Muscle Group' datatype='string' name='[primary_muscle_group]' role='dimension' type='nominal' />
            <column caption='Reps' datatype='integer' name='[reps]' role='measure' type='quantitative' />
            <column caption='Start Time Utc' datatype='datetime' name='[start_time_utc]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0328254913155082]' derivation='Sum' name='[sum:Calculation_0328254913155082:qk]' pivot='key' type='quantitative' />
            <column-instance column='[start_time_utc]' derivation='Week-Trunc' name='[twk:start_time_utc:qk]' pivot='key' type='quantitative' />
            <column caption='Weight Kg' datatype='real' name='[weight_kg]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
