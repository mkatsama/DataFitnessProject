          <datasource-dependencies datasource='federated.0hpekg91c024ad1ccbvpn1flcucs'>
            <column caption='LOOKUP(AVG([Daily Strain (Whoop!Daily2)]), -1)' datatype='real' name='[Calculation_2061502858317830]' role='measure' type='quantitative' user:unnamed='Sheet 4'>
              <calculation class='tableau' formula='  LOOKUP(AVG([daily_strain (whoop!daily2)]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WhoopRecovery' datatype='string' name='[Calculation_2061502859587591]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [recovery_score (whoop!daily2)] &gt;= 67 THEN &quot;Green&quot;&#10;ELSEIF [recovery_score (whoop!daily2)] &gt;= 34 THEN &quot;Yellow&quot;&#10;ELSE &quot;Red&quot;&#10;END' />
            </column>
            <column-instance column='[recovery_score (whoop!daily2)]' derivation='Avg' name='[avg:recovery_score (whoop!daily2):qk]' pivot='key' type='quantitative' />
            <column caption='Daily Strain (Whoop!Daily2)' datatype='real' name='[daily_strain (whoop!daily2)]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2061502859587591]' derivation='None' name='[none:Calculation_2061502859587591:nk]' pivot='key' type='nominal' />
            <column-instance column='[whoop_date (whoop!daily2)]' derivation='None' name='[none:whoop_date (whoop!daily2):qk]' pivot='key' type='quantitative' />
            <column caption='Recovery Score (Whoop!Daily2)' datatype='integer' name='[recovery_score (whoop!daily2)]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2061502858317830]' derivation='User' name='[usr:Calculation_2061502858317830:qk:4]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Field'>
                <order field='[federated.0hpekg91c024ad1ccbvpn1flcucs].[whoop_date (whoop!daily2)]' />
                <order field='[federated.0hpekg91c024ad1ccbvpn1flcucs].[Calculation_2061502859587591]' />
              </table-calc>
            </column-instance>
            <column caption='Whoop Date (Whoop!Daily2)' datatype='datetime' datatype-customized='true' name='[whoop_date (whoop!daily2)]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0hpekg91c024ad1ccbvpn1flcucs].[usr:Calculation_2061502858317830:qk:4]' scope='cols' value='Daily Strain - Day Before' />
            <format attr='title' class='0' field='[federated.0hpekg91c024ad1ccbvpn1flcucs].[avg:recovery_score (whoop!daily2):qk]' scope='rows' value='Avg Recovery Score' />
